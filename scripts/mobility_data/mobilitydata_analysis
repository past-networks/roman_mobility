```{r dual resolution clustering}
# Filter to rows with valid origin geometry and convert to sf
origo_clean_data <- origo_data %>%
  filter(!is.na(origo_geometry))

origo_sf     <- st_as_sf(origo_clean_data, wkt = "origo_geometry", crs = 4326)
origo_metric <- st_transform(origo_sf, 3035)

# Compute distance matrix and run hierarchical clustering once
dist_matrix <- st_distance(origo_metric)
hc_results  <- hclust(as.dist(dist_matrix), method = "complete")

# Cut the dendrogram at two thresholds for comparison
origo_sf$cluster_id_10km <- as.factor(cutree(hc_results, h = 10000))  # Fine: 10 km
origo_sf$cluster_id_50km <- as.factor(cutree(hc_results, h = 50000))  # Coarse: 50 km

# Copy cluster IDs to the metric object so they survive the jitter transform
origo_metric$cluster_id_10km <- origo_sf$cluster_id_10km
origo_metric$cluster_id_50km <- origo_sf$cluster_id_50km

# 5 km buffers for visualising the 50 km regional zones
origo_buffers_50km <- st_buffer(origo_metric, dist = 5000)

# Jitter overlapping points slightly (2 km) to aid visual separation, then back to 4326
origo_sf_jittered <- st_jitter(origo_metric, amount = 2000) %>%
  st_transform(4326)

# Visualise: 50 km cluster regions as background, individual points on top
tmap_mode("view")

map_viz2 <- tm_shape(provinces) +
  tm_polygons(fill = "grey95", col = "white", fill_alpha = 0.5) +

  # 50 km regional cluster zones
  tm_shape(origo_buffers_50km) +
  tm_polygons(fill          = "cluster_id_50km",
              fill_alpha    = 0.3,
              col           = "cluster_id_50km",
              fill.legend   = tm_legend_hide(),
              col.legend    = tm_legend_hide()) +

  # Individual jittered origin points with both cluster IDs in popup
  tm_shape(origo_sf_jittered) +
  tm_dots(fill       = "black",
          size       = 0.1,
          popup.vars = c("edh_person_id", "name", "origo_clean",
                         "cluster_id_10km", "cluster_id_50km")) +

  tm_view(set_zoom_limits = c(4, 12))

map_viz2

# Summary statistics
print(paste("Unique Locations:", length(unique(origo_sf$origo_geometry))))
print(paste("10km Clusters:",    nlevels(origo_sf$cluster_id_10km)))
print(paste("50km Clusters:",    nlevels(origo_sf$cluster_id_50km)))
```

