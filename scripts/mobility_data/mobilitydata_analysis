# Hexagon grid of both origin and destination places. Number of people per cell determines the colour.

```{r hexagons origo res 12}
# Build hexagon grid over origin places at resolution 12 (~96 km² per cell)
dggs_12 <- dgconstruct(res = 12, metric = TRUE, resround = "nearest")

# Assign each origin point to its hexagonal cell
coords_12        <- st_coordinates(origo_sf)
origo_sf$cell_12 <- dgGEO_to_SEQNUM(dggs_12, coords_12[, 1], coords_12[, 2])$seqnum

# Count how many points fall into each cell
cell_counts_12 <- origo_sf %>%
  st_drop_geometry() %>%
  count(cell_12, name = "n_points")

# Build the hex grid polygons and assign CRS
hex_grid_12 <- dgcellstogrid(dggs_12, cell_counts_12$cell_12) %>%
  st_as_sf()
st_crs(hex_grid_12) <- 4326

# Join point counts onto the hex grid
hex_grid_12 <- merge(hex_grid_12, cell_counts_12, by.x = "seqnum", by.y = "cell_12")

# Visualise interactively
tmap_mode("view")

map_origo_12 <- tm_shape(provinces) +
  tm_polygons(fill = "grey95", col = "white", fill_alpha = 0.5) +

  tm_shape(hex_grid_12) +
  tm_polygons(
    fill       = "n_points",
    fill.scale = tm_scale_continuous(values = "plasma"),
    fill_alpha = 0.7,
    col        = "white",
    lwd        = 0.3,
    id         = "seqnum",
    popup.vars = c("Cell ID" = "seqnum", "Points" = "n_points")
  ) +

  tm_shape(origo_sf) +
  tm_dots(fill = "black", size = 0.05, alpha = 0.5) +

  tm_view(set_zoom_limits = c(3, 10))

print(map_origo_12)
```

