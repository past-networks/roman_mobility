```{r buffer and clusters}
# Project to ETRS89-LAEA (EPSG:3035) - metric CRS required for distance-based operations
origo_metric <- st_transform(origo_sf, 3035)

# Generate 5 km buffers around each origin point
origo_buffers <- st_buffer(origo_metric, dist = 5000)

# Compute pairwise distance matrix between all origin points (in metres)
dist_matrix <- st_distance(origo_metric)

# Hierarchical clustering with complete linkage (prevents chaining within clusters)
# Complete linkage: no two points in the same cluster are more than 10 km apart
hc_results         <- hclust(as.dist(dist_matrix), method = "complete")
cluster_assignments <- as.factor(cutree(hc_results, h = 10000))

# Attach cluster IDs to both point and buffer objects
origo_sf$cluster_id      <- cluster_assignments
origo_buffers$cluster_id <- cluster_assignments

# Transform provinces to metric CRS for spatial consistency in this chunk
provinces_metric <- st_transform(provinces, 3035)

# Visualise buffers and clustered points
tmap_mode("view")

map_viz <- tm_shape(provinces_metric) +
  tm_polygons(fill = "grey90", col = "white", fill_alpha = 0.5) +

  # Colour-coded buffers by cluster
  tm_shape(origo_buffers) +
  tm_polygons(fill          = "cluster_id",
              fill_alpha    = 0.3,
              col           = "cluster_id",
              fill.legend   = tm_legend_hide(),
              col.legend    = tm_legend_hide()) +

  # Individual origin points with popup info
  tm_shape(origo_sf) +
  tm_dots(fill       = "black",
          size       = 0.01,
          popup.vars = c("edh_person_id", "edh_inscription_id",
                         "name", "cluster_id", "origo_clean")) +

  tm_view(set_zoom_limits = c(4, 12))

map_viz

# Export cluster assignments for further analysis
cluster_export <- origo_sf %>%
  st_drop_geometry() %>%
  select(edh_person_id, edh_inscription_id, cluster_id, origo_clean)

write.csv(cluster_export,
          "../origo_clusters_assigned.csv",
          row.names = FALSE)
```

