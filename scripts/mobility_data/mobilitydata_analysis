```{r top 10 routes network}
# Filter to rows with both geometries present and resolve best available place names
migrants <- origo_data %>%
  filter(!is.na(origo_geometry) & !is.na(findspot_geometry)) %>%
  mutate(
    origin_name   = coalesce(origo_pleiades_name, origo_clean, origo),
    findspot_name = coalesce(findspot_ancient, findspot_modern, findspot_name)
  ) %>%
  filter(!is.na(origin_name) & !is.na(findspot_name))

# Check how many valid migration records we have
nrow(migrants)

# Count people per route, excluding same-place moves (self-loops)
top_pairs <- migrants %>%
  filter(origin_name != findspot_name) %>%
  group_by(origin_name, findspot_name) %>%
  summarise(
    num_people = n(),
    person_ids = paste(edh_person_id, collapse = ", "),
    .groups = "drop"
  ) %>%
  arrange(desc(num_people)) %>%
  head(10)

print(top_pairs %>% select(origin_name, findspot_name, num_people))

# Collect all unique locations appearing in the top 10 routes
top_origins    <- unique(top_pairs$origin_name)
top_findspots  <- unique(top_pairs$findspot_name)
all_top_locations <- unique(c(top_origins, top_findspots))

# Calculate emigrant counts per origin
emigrants <- top_pairs %>%
  group_by(origin_name) %>%
  summarise(emigrants = sum(num_people))

# Calculate immigrant counts per destination
immigrants <- top_pairs %>%
  group_by(findspot_name) %>%
  summarise(immigrants = sum(num_people))

# Build node table with role classification (Source / Destination / Both)
nodes <- data.frame(name = all_top_locations, stringsAsFactors = FALSE) %>%
  left_join(emigrants,  by = c("name" = "origin_name")) %>%
  left_join(immigrants, by = c("name" = "findspot_name")) %>%
  mutate(
    emigrants     = ifelse(is.na(emigrants),  0, emigrants),
    immigrants    = ifelse(is.na(immigrants), 0, immigrants),
    total_traffic = emigrants + immigrants,
    role = case_when(
      emigrants > 0 & immigrants == 0 ~ "Source only",
      immigrants > 0 & emigrants == 0 ~ "Destination only",
      TRUE                            ~ "Both"
    )
  ) %>%
  arrange(desc(total_traffic))

print(nodes)

# Build directed network graph from top pairs
network <- graph_from_data_frame(
  d        = top_pairs %>% select(from = origin_name, to = findspot_name, weight = num_people),
  directed = TRUE,
  vertices = nodes
)

# Network visualisation: Fruchterman-Reingold layout
png("top10_pairs_improved.png", width = 3000, height = 2400, res = 300)
par(mar = c(1, 1, 3, 1))

set.seed(123)
layout_fr <- layout_with_fr(network)  # Force-directed layout for organic spacing

# Node sizes scaled by total traffic
V(network)$size <- sqrt(V(network)$total_traffic) * 2

# Edge width proportional to number of people (log-scaled to avoid dominance)
E(network)$width <- log1p(E(network)$weight) * 1.5

# Assign a distinct colour to each of the 10 edges
edge_colors <- colorRampPalette(brewer.pal(9, "Set1"))(10)
E(network)$color <- adjustcolor(edge_colors, alpha.f = 0.7)

# Colour nodes by their role
node_colors <- c("Source only" = "#4292C6", "Destination only" = "#E31A1C", "Both" = "#74C476")
V(network)$color <- adjustcolor(node_colors[V(network)$role], alpha.f = 0.9)

plot(network,
     layout             = layout_fr,
     vertex.label       = V(network)$name,
     vertex.label.cex   = 0.9,
     vertex.label.color = "black",
     vertex.label.font  = 2,
     vertex.label.dist  = 1.5,
     vertex.frame.color = "white",
     vertex.frame.width = 2,
     edge.curved        = 0.2,
     edge.arrow.size    = 0.7,
     edge.arrow.width   = 1.5,
     main = "Top 10 Migration Routes\n(Each route has unique color)")

legend("bottomleft",
       legend = c("Source Only", "Destination Only", "Both Origin & Destination"),
       col    = node_colors,
       pch    = 19,
       pt.cex = 2,
       cex    = 0.8,
       title  = "Location Roles",
       bty    = "n")

dev.off()

# Bar chart of top 10 routes
top_pairs_plot <- top_pairs %>%
  mutate(
    route_short = paste(substr(origin_name, 1, 15), "→", substr(findspot_name, 1, 15))
  )

ggplot(top_pairs_plot, aes(x = reorder(route_short, num_people), y = num_people)) +
  geom_col(aes(fill = num_people), alpha = 0.8, width = 0.7) +
  geom_text(aes(label = num_people), hjust = -0.3, size = 4.5, fontface = "bold") +
  scale_fill_gradientn(colors = c("#FED976", "#FD8D3C", "#E31A1C")) +
  coord_flip() +
  labs(title    = "Top 10 Migration Routes by Number of People",
       subtitle = "Routes with same origin/destination excluded",
       x = NULL,
       y = "Number of People",
       fill = "People") +
  theme_minimal() +
  theme(legend.position  = "none",
        axis.text.y      = element_text(size = 10, face = "bold"),
        plot.title       = element_text(size = 15, face = "bold"),
        plot.subtitle    = element_text(size = 11))

ggsave("top10_pairs_bar_clean.png", width = 11, height = 8, dpi = 300)

# Individual route cards: one mini-arrow plot per route
png("top10_routes_detail.png", width = 3000, height = 2000, res = 300)
par(mfrow = c(2, 5), mar = c(2, 2, 3, 1))

for (i in 1:10) {
  route <- top_pairs[i, ]

  plot(c(0, 1), c(0, 1), type = "n", axes = FALSE, xlab = "", ylab = "",
       main = paste0("#", i, ": ", route$num_people, " people"))

  # Draw directional arrow from origin to destination
  arrows(x0 = 0.15, y0 = 0.5, x1 = 0.85, y1 = 0.5,
         length = 0.15, lwd = 3, col = edge_colors[i])

  # Label origin and destination
  text(0.1, 0.5, route$origin_name,   adj = 1, cex = 0.8, font = 2)
  text(0.9, 0.5, route$findspot_name, adj = 0, cex = 0.8, font = 2)
}

dev.off()

# Self-loop check: people inscribed in same place as origin
self_loops <- migrants %>%
  filter(origin_name == findspot_name) %>%
  group_by(origin_name) %>%
  summarise(count = n()) %>%
  arrange(desc(count))

if (nrow(self_loops) > 0) {
  cat("Found", nrow(self_loops), "locations with self-loops (same origin and findspot):\n")
  print(head(self_loops, 10))
  cat("\nThese are EXCLUDED from the top 10 pairs analysis.\n")
} else {
  cat("No self-loops found.\n")
}

# Bidirectional route check: are any top routes travelled both ways?
bidirectional <- top_pairs %>%
  inner_join(
    top_pairs,
    by     = c("origin_name" = "findspot_name", "findspot_name" = "origin_name"),
    suffix = c("_forward", "_backward")
  ) %>%
  filter(origin_name < findspot_name) %>%
  select(location_A = origin_name,
         location_B = findspot_name,
         A_to_B     = num_people_forward,
         B_to_A     = num_people_backward) %>%
  mutate(total = A_to_B + B_to_A)

if (nrow(bidirectional) > 0) {
  cat("Found", nrow(bidirectional), "bidirectional route(s):\n")
  print(bidirectional)
} else {
  cat("No bidirectional routes in top 10 (all routes are one-directional).\n")
}
