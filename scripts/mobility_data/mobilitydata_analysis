```{r top 10 routes hierarchical network}
# Rebuild network (origins left, destinations right, mixed in centre)
network <- graph_from_data_frame(
  d        = top_pairs %>% select(from = origin_name, to = findspot_name, weight = num_people),
  directed = TRUE,
  vertices = nodes
)

png("top10_pairs_hierarchical.png", width = 3600, height = 3000, res = 300)
par(mar = c(1, 1, 3, 1))

# Separate nodes by role for manual column layout
source_only <- nodes$name[nodes$role == "Source only"]
dest_only   <- nodes$name[nodes$role == "Destination only"]
both        <- nodes$name[nodes$role == "Both"]

# Assign x/y positions: sources left (x=0), mixed centre (x=5), destinations right (x=10)
n_nodes       <- vcount(network)
custom_layout <- matrix(0, nrow = n_nodes, ncol = 2)

for (i in 1:n_nodes) {
  node_name <- V(network)$name[i]

  if (node_name %in% source_only) {
    custom_layout[i, 1] <- 0
    custom_layout[i, 2] <- which(source_only == node_name) * 2
  } else if (node_name %in% dest_only) {
    custom_layout[i, 1] <- 10
    custom_layout[i, 2] <- which(dest_only == node_name) * 1.5
  } else {
    custom_layout[i, 1] <- 5
    custom_layout[i, 2] <- which(both == node_name) * 3
  }
}

plot(network,
     layout             = custom_layout,
     vertex.label       = V(network)$name,
     vertex.label.cex   = 1.0,
     vertex.label.color = "black",
     vertex.label.font  = 2,
     vertex.label.dist  = 1.5,
     vertex.size        = sqrt(V(network)$total_traffic) * 2.5,
     vertex.color       = adjustcolor(node_colors[V(network)$role], alpha.f = 0.95),
     vertex.frame.color = "white",
     vertex.frame.width = 3,
     edge.curved        = 0.15,
     edge.width         = log1p(E(network)$weight) * 2,
     edge.color         = adjustcolor(edge_colors, alpha.f = 0.7),
     edge.arrow.size    = 1.0,
     edge.arrow.width   = 2,
     main = "Top 10 Migration Routes\n(Hierarchical: Sources → Destinations)")

# Column dividers and labels
abline(v = c(0, 5, 10), lty = 2, col = "gray80")
text(0,  max(custom_layout[, 2]) + 1, "SOURCES",      cex = 1.2, font = 2)
text(5,  max(custom_layout[, 2]) + 1, "BOTH",         cex = 1.2, font = 2)
text(10, max(custom_layout[, 2]) + 1, "DESTINATIONS", cex = 1.2, font = 2)

dev.off()

# Grid of individual route arrows
png("top10_pairs_grid.png", width = 3600, height = 2400, res = 300)
par(mfrow = c(2, 5), mar = c(3, 2, 3, 2))

for (i in 1:10) {
  route <- top_pairs[i, ]

  plot(c(0, 1), c(0, 1), type = "n", axes = FALSE, xlab = "", ylab = "",
       main     = paste0("#", i, ": ", route$num_people, " people\n",
                         substr(route$origin_name,   1, 20), " → ",
                         substr(route$findspot_name, 1, 20)),
       cex.main = 0.9)

  arrows(x0 = 0.2, y0 = 0.5, x1 = 0.8, y1 = 0.5,
         length = 0.2, lwd = 5, col = edge_colors[i])

  # Origin label in blue, destination in red
  text(0.1, 0.5, route$origin_name,   adj = c(1, 0.5), cex = 0.9, font = 2, col = "#4292C6")
  text(0.9, 0.5, route$findspot_name, adj = c(0, 0.5), cex = 0.9, font = 2, col = "#E31A1C")

  # Person count centred above the arrow
  text(0.5, 0.7, paste(route$num_people, "people"), cex = 1.1, font = 2)
}

dev.off()
