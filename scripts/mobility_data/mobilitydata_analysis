# Network visualisation of mobility projected onto the map. Red points are destinations, blue are origins. The network is unidirectional.

```{r network on map styled}
# Filter to rows where both geometries are present
network_clean <- origo_data %>%
  filter(!is.na(origo_geometry), !is.na(findspot_geometry))

# Aggregate to top 30 routes by traveller count
top_30_routes <- network_clean %>%
  group_by(origo_clean, findspot_ancient) %>%
  summarise(
    traveler_count    = n(),
    origo_geometry    = first(origo_geometry),
    findspot_geometry = first(findspot_geometry),
    .groups = "drop"
  ) %>%
  arrange(desc(traveler_count)) %>%
  slice(1:30)

# Build line geometries connecting each origin–destination pair
top_30_lines <- st_sf(
  top_30_routes %>% select(origo_clean, findspot_ancient, traveler_count),
  geometry = purrr::map2(
    top_30_routes$origo_geometry,
    top_30_routes$findspot_geometry,
    ~ st_linestring(rbind(
      st_coordinates(st_as_sfc(.x, crs = 4326)[])[1, 1:2],[3]
      st_coordinates(st_as_sfc(.y, crs = 4326)[])[1, 1:2][3]
    ))
  ) %>% st_sfc(crs = 4326)
)

# One point per unique origin location (aggregated traveller count)
origo_pts <- st_as_sf(
  top_30_routes %>%
    filter(!is.na(origo_geometry)) %>%
    mutate(origo_clean = replace_na(origo_clean, "Unknown")) %>%
    group_by(origo_clean, origo_geometry) %>%
    summarise(traveler_count = sum(traveler_count), .groups = "drop"),
  wkt = "origo_geometry",
  crs = 4326
)

# One point per unique findspot location (aggregated traveller count)
findspot_pts <- st_as_sf(
  top_30_routes %>%
    filter(!is.na(findspot_geometry)) %>%
    mutate(findspot_ancient = replace_na(findspot_ancient, "Unknown")) %>%
    group_by(findspot_ancient, findspot_geometry) %>%
    summarise(traveler_count = sum(traveler_count), .groups = "drop"),
  wkt = "findspot_geometry",
  crs = 4326
)

# Visualise: provinces base, route lines, origin dots (blue), destination dots (red)
tmap_mode("view")

map_viz <- tm_shape(provinces) +
  tm_polygons(fill = "grey95", col = "white", fill_alpha = 0.5) +

  tm_shape(top_30_lines) +
  tm_lines(
    col        = "grey50",
    lwd        = 1,
    alpha      = 0.6,
    id         = "origo_clean",
    popup.vars = c("From"  = "origo_clean",
                   "To"    = "findspot_ancient",
                   "Count" = "traveler_count")
  ) +

  tm_shape(origo_pts) +
  tm_dots(fill = "#4292C6", size = 0.4, id = "origo_clean") +

  tm_shape(findspot_pts) +
  tm_dots(fill = "#E31A1C", size = 0.4, id = "findspot_ancient") +

  tm_view(set_zoom_limits = c(3, 10))

map_viz
```

# Network with geometry lines for the map - simple uniform visualisation.

```{r network on map simple}
# Filter to valid movements (both geometries present)
network_raw <- origo_data %>%
  filter(!is.na(origo_geometry), !is.na(findspot_geometry))

# Summarise top 30 routes and keep one geometry example per route for inspection
route_summary <- network_raw %>%
  group_by(origo_clean, findspot_ancient) %>%
  summarise(
    traveler_count    = n(),
    origo_geom_raw    = first(origo_geometry),
    findspot_geom_raw = first(findspot_geometry),
    .groups = "drop"
  ) %>%
  arrange(desc(traveler_count)) %>%
  slice(1:30)

# Inspect the top 30 routes
print(route_summary)

# Save summary for reporting
write.csv(route_summary,
          "../top_30_mobility_routes.csv",
          row.names = FALSE)

# Extract geometry columns as sfc objects (vectorised, faster than row-by-row)
origo_sfc    <- st_as_sfc(route_summary$origo_geom_raw,    crs = 4326)
findspot_sfc <- st_as_sfc(route_summary$findspot_geom_raw, crs = 4326)

# Build straight lines between each origin–destination pair
mobility_lines <- purrr::map2(origo_sfc, findspot_sfc,
                               ~ st_linestring(rbind(.x, .y))) %>%
  st_sfc(crs = 4326)

# Attach line geometry to the route summary table
top_30_sf <- st_sf(route_summary, geometry = mobility_lines)

# Simple visualisation: uniform red lines, no size scaling
tmap_mode("view")

map_raw_network <- tm_shape(provinces) +
  tm_polygons(fill = "grey90", col = "white", fill_alpha = 0.5) +

  tm_shape(top_30_sf) +
  tm_lines(
    col        = "firebrick",
    lwd        = 2,
    alpha      = 0.8,
    id         = "origo_clean",
    popup.vars = c("From"       = "origo_clean",
                   "To"         = "findspot_ancient",
                   "Count"      = "traveler_count",
                   "Start_Geom" = "origo_geom_raw",
                   "End_Geom"   = "findspot_geom_raw")
  )

map_raw_network
```

