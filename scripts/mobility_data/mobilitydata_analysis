# Examining the data, shape, and network creation of the 10 most used routes
# with origin and findspots (even the same city) as separate nodes.

```{r packages}
library(arrow)        # Reading parquet files
library(readr)        # Reading CSV files
library(dplyr)        # Data manipulation
library(igraph)       # Network graph creation and analysis
library(ggplot2)      # Static plotting
library(tidyr)        # Data reshaping
library(sf)           # Spatial data handling (simple features)
library(tmap)         # Interactive and static map visualisation
library(cluster)      # Hierarchical clustering
library(tidyverse)    # Core tidyverse (includes ggplot2, dplyr, tidyr etc.)
library(dggridR)      # Discrete global hexagon grids
library(RColorBrewer) # Colour palettes
```

```{r load data}
# Load the variable dictionary explaining each column in the dataset
dictionary <- read.csv("../origo_variable_dictionary.csv")

# Load the main mobility dataset (parquet format for efficiency)
origo_data <- read_parquet("../origo_geo.parquet")

# Load Roman province boundaries and transform to WGS84 (EPSG:4326) for mapping
# NOTE: 4326 is used as the base CRS throughout; 3035 is applied locally for metric operations
provinces <- st_read("../roman_province_boundaries.json") %>%
  st_transform(4326)

# Convert origo (origin) geometry column from WKT to sf spatial object
origo_sf <- origo_data %>%
  filter(!is.na(origo_geometry)) %>%
  st_as_sf(wkt = "origo_geometry", crs = 4326)

# Convert findspot geometry column from WKT to sf spatial object
findspot_sf <- origo_data %>%
  filter(!is.na(findspot_geometry)) %>%
  st_as_sf(wkt = "findspot_geometry", crs = 4326)
```

